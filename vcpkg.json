{
  "name": "lumen",
  "version-string": "1.1.0",
  "description": "Lightweight cross-platform image browser and comparison tool",
  "license": "MIT",
  "dependencies": [
    { "name": "libraw", "default-features": false },
    { "name": "libjpeg-turbo", "default-features": false },
    { "name": "libjxl", "default-features": false },
    { "name": "openexr", "default-features": false },
    { "name": "exiv2", "default-features": false, "features": ["png", "xmp"] }
  ],
  "features": {
    "color-management": {
      "description": "Convert embedded ICC profiles to sRGB with LittleCMS",
      "dependencies": [
        {
          "name": "lcms",
          "default-features": false
        }
      ]
    }
  }
}
